{
    // OpenCode v2-native config — v2-only; 1.18.x is NOT supported. Every key
    // is the v2 dialect (plugins / providers / agents / commands / permissions
    // / media). The v1 spellings (plugin, provider, agent, command, permission,
    // attachment, small_model, top-level subagent_depth) are never written:
    // any one of them flips v2's loader onto its V1→V2 migration path. See
    // README「v2 原生键名」for the key map and the verification method.
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "orchestrator",
    "model": "deepseek/deepseek-flash",
    "update": "notify",
    "share": "disabled",
    "lsp": true,
    "formatter": true,
    // Nesting cap = the deepest chain the agent graph actually uses:
    // orchestrator → light-orchestrator → oracle (2 spawn levels). Every other
    // subagent is denied `task`, so a third level is dead headroom that only
    // enables accidental token amplification. `experimental.subagent_depth` is
    // the v2 key; the v1 top-level spelling is dropped and not written.
    "experimental": {
        "subagent_depth": 2
    },
    // Ordered permission ruleset, last-match-wins. Default-ask instead of
    // default-allow: an unrecognized destructive variant (e.g. `rm -rf`
    // spelled or spaced differently) matches only `*` and is put to a human.
    // The catch-all `*` goes FIRST — every specific rule below overrides it.
    // The allow list covers high-frequency read-only or local operations
    // (git status/diff/log/show, git add/commit, npm run/test, rg, node
    // scripts/*); anything else, destructive variants included, falls through
    // to ask. Known danger patterns are deliberately NOT listed as extra
    // `ask` rules: the catch-all already sends them to a human, and under
    // last-match-wins any later `ask` rule would be a dead rule.
    "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": ".env", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": ".envrc", "effect": "deny" },
        { "action": "read", "resource": "*.envrc", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git stash list*", "effect": "allow" },
        { "action": "shell", "resource": "git add *", "effect": "allow" },
        { "action": "shell", "resource": "git commit*", "effect": "allow" },
        { "action": "shell", "resource": "node scripts/*", "effect": "allow" },
        { "action": "shell", "resource": "npm run *", "effect": "allow" },
        { "action": "shell", "resource": "npm test*", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" }
    ],
    // Pinned to an immutable tag on purpose: a plugin bump can rewrite the
    // bootstrap it injects into the first user message, which busts the prompt
    // cache prefix of every session. Bump deliberately, re-read the release
    // notes, then confirm `.opencode/plugins/superpowers.js` is still
    // byte-identical (that file is the whole opencode integration).
    "plugins": [
        "superpowers@git+https://github.com/obra/superpowers.git#v7.0.1"
    ],
    // No `instructions` entry: AGENTS.md is already loaded by discovery — the
    // global config dir plus the project-root walk (core/instruction-discovery.ts,
    // both scopes default true). Listing it again only added a redundant rescan.

    // Single-model config: `deepseek-flash` is the ONLY model. Agents differ
    // only in thinking mode, expressed as model variants so the choice stays
    // at the model layer:
    //   (no suffix) thinking OFF + temperature 0   — cheapest, router/simple;
    //   #low        thinking ON, effort `low`       — routine planning;
    //   #high       thinking ON, effort `high`      — deep reasoning/review.
    // Upstream default is thinking ON at effort `high` (DeepSeek thinking-mode
    // guide, re-checked 2026-10-27). So only the no-suffix tier actually saves
    // reasoning tokens — it must send `disabled` explicitly; `#high` merely
    // restates the default, and `#low` is the one middle rung that exists.
    // There is no medium effort: `minimal`→low, `medium`/`xhigh`→high,
    // `max`/`ultra`→max.
    // `deepseek-flash` is the merged V4.1 Flash model — the former text-only
    // and vision variants are now one natively-multimodal model, so it carries
    // the `capabilities` block (image input). Without it OpenCode treats the
    // model as text-only and rejects read_image calls.
    // Two distinct mechanisms, deliberately kept apart:
    //   toggle — `{"thinking":{"type":"enabled"|"disabled"}}`, a BODY field;
    //   effort — `{"reasoning_effort":"low"|"high"|"max"}`, driven from the
    //            `settings.reasoningEffort` provider setting (camelCase in
    //            config, snake_case on the wire). Neither is a native schema
    //            field; both are DeepSeek API request parameters.
    // Effort is a model VARIANT rather than a per-agent option: an agent cannot
    // carry provider settings (`request` overlays only `headers`/`body`), and
    // OpenCode's own DeepSeek mapping resolves effort through `settings`. Every
    // tier bills at the same flash rate; higher effort only buys extra
    // reasoning tokens.
    "providers": {
        "deepseek": {
            "models": {
                "deepseek-flash": {
                    // The thinking toggle and temperature are REQUEST BODY
                    // fields, not provider options. `settings` reaches the
                    // provider package as options, and the openai-chat protocol
                    // implements no `thinking` or `temperature` option, so both
                    // keys were inert while they sat under `settings`: flash ran
                    // with thinking at its default (ON) and paid reasoning
                    // tokens on every step of every flash task. `body` is
                    // provably merged into the serialized request, which is also
                    // where opencode's own DeepSeek mapping writes the toggle
                    // (core/variant.ts — the `deepseekChat` protocol emits
                    // `body: {thinking: {type: "disabled"}}` for a non-thinking
                    // run).
                    // `temperature: 0` binds ONLY on this thinking-off tier:
                    // with thinking on, the API ignores temperature,
                    // presence_penalty and frequency_penalty — no error, no
                    // effect — so the variants inherit it inertly. Do not try
                    // to null it out per variant: mergeOverlay treats `null` as
                    // a value (only `undefined` keeps the base), so it would be
                    // serialized onto the wire.
                    "body": {
                        "thinking": { "type": "disabled" },
                        "temperature": 0
                    },
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    // The two non-default tiers. Effort is a provider setting,
                    // not a body key: `settings.reasoningEffort` is what the
                    // aisdk layer forwards as the API's `reasoning_effort`
                    // (core/aisdk.ts reads it; ai/protocols/openai-chat.ts maps
                    // it into the body), while the toggle rides `body`. Agents
                    // select a variant with `model:
                    // deepseek/deepseek-flash#low` or `#high`. Each variant must
                    // restate `thinking: enabled`: the model level disables it
                    // and the overlay deep-merges, so a variant that omitted the
                    // toggle would inherit `disabled`. `top_p` stays unset on
                    // purpose — on flash it applies only with thinking on
                    // (0.95-1.0, values below clamp to 0.95) and is pinned to
                    // 1.0 when thinking is off.
                    "variants": [
                        {
                            "id": "low",
                            "settings": { "reasoningEffort": "low" },
                            "body": { "thinking": { "type": "enabled" } }
                        },
                        {
                            "id": "high",
                            "settings": { "reasoningEffort": "high" },
                            "body": { "thinking": { "type": "enabled" } }
                        }
                    ],
                    // `cost` is USD per 1M tokens — official off-peak rates,
                    // re-verified against the pricing page 2026-10-27. Peak
                    // hours (UTC 01-04 & 06-10 Mon-Fri, excluding Chinese
                    // public holidays = Beijing 09-12 & 14-18) charge double,
                    // so this table under-reports peak-time spend by ~2x; it
                    // drives OpenCode's own cost display only. DeepSeek
                    // publishes no standalone cache-write price — writes bill
                    // at the cache-miss input rate, so `cache.write` mirrors
                    // input. Off-peak is exactly half of peak.
                    "cost": [
                        { "input": 0.15, "output": 0.60, "cache": { "read": 0.003, "write": 0.15 } }
                    ],
                    // `limit.input` is the ONE knob that decides when built-in
                    // compaction fires. Overflow computes:
                    //     usable = limit.input - compaction.buffer
                    // Without `input`, usable falls back to
                    // `context - maxOutputTokens` = 968,000, i.e. a session
                    // could grow to ~968K tokens before anything is
                    // compressed. Declaring `input` turns the cap into an
                    // explicit working budget: 131072 - 16000 = 115,072 tokens
                    // (see the compaction block below).
                    "limit": {
                        "context": 1000000,
                        "input": 131072,
                        "output": 384000
                    }
                }
            }
        }
    },
    "references": {
        "opencode-docs": {
            "repository": "anomalyco/opencode",
            "branch": "dev",
            "description": "Official opencode docs, schema, and configuration examples"
        },
        "deepseek-harness": {
            "repository": "deepseek-ai/deepseek-harness",
            "description": "Official DeepSeek model config guidance: thinking toggle, temperature, prompt-caching, context-window handling, OpenAI-compatible API setup"
        }
    },
    // Built-in agents (no .md file). `model` here binds only three surfaces
    // (verified against v2.0.27 + live runs; source re-checked on v2.2.0
    // 2026-10-27): subagent/child sessions — incl.
    // `general` (the superpowers Task dispatch target) and `/` commands bound
    // to subagent-mode agents — the title/summary/compaction one-shots, and
    // the desktop composer's per-agent default for new sessions (build/plan
    // -> flash). The main `opencode run` session ignores it: `-m` > stored
    // session model > root `model` (flash), so pick a tier there with
    // `-m deepseek/deepseek-flash#high`. Thinking is controlled at the
    // provider layer (default off, variants on), so no per-agent temperature
    // or variant here. Heavy work escalates to deep-worker (flash#high).
    //
    // `permissions` on an inline agent are APPENDED after that agent's
    // built-in rules and after the global `permissions` list above, so under
    // last-match-wins they always win. The three hidden one-shot agents never
    // load a skill, and denying the skill action strips the whole
    // `<available_skills>` roster (30 entries, ~11.8 KB ≈ 3.3K tokens,
    // measured 2026-10-16) out of every title / summary / compaction request.
    // This also repairs a real defect: title and summary ship a built-in
    // `*:* deny` lock, but the global `skill:* allow` below it was silently
    // re-opening the roster.
    //
    // Skill permissions are the ONLY roster filter that scales: core builds
    // the roster from the skills a ruleset does not deny
    // (core/skill/instructions.ts), so each agent's `skill` allowlist in
    // `agents/*.md` sets exactly what that agent sees on every request.
    "agents": {
        "build": { "model": "deepseek/deepseek-flash" },
        "general": { "model": "deepseek/deepseek-flash" },
        "plan": { "model": "deepseek/deepseek-flash" },
        "title": {
            "model": "deepseek/deepseek-flash",
            "permissions": [{ "action": "skill", "resource": "*", "effect": "deny" }]
        },
        "summary": {
            "model": "deepseek/deepseek-flash",
            "permissions": [{ "action": "skill", "resource": "*", "effect": "deny" }]
        },
        "compaction": {
            "model": "deepseek/deepseek-flash",
            "permissions": [{ "action": "skill", "resource": "*", "effect": "deny" }]
        }
    },
    // Trim only oversized tool outputs (full text still saved to disk, preview
    // returned). 800 lines / 20KB is more conservative than the official
    // default (max_lines=2000) yet loose enough to avoid truncating normal file
    // reads — 200/8192 was too tight and forced agents to re-read, costing more
    // tokens than the tighter preview saved.
    "tool_output": {
        "max_lines": 800,
        "max_bytes": 20480
    },
    // Built-in context compaction is the ONLY compression layer (no DCP): it
    // runs the `compaction` agent (flash — see the agents block) over the head
    // of the session and keeps a verbatim tail.
    //
    // When it fires: session tokens >= limit.input - buffer.
    //     flash: 131072 - 16000 = 115,072
    // That window sits far below the 1M hard limit on purpose: every request
    // re-sends the whole context, so a 968K session (the un-capped default)
    // costs ~8x more per request than a compacted one on cache misses and
    // ~8x more on cache reads too. Compacting early is the cheapest lever
    // available in a pure-config setup.
    //
    // `keep.tokens` is the verbatim tail kept across a compaction; everything
    // older is replaced by the summary the compaction agent writes. `buffer`
    // is the overflow headroom during compaction. The v1 spellings (`reserved`,
    // `preserve_recent_tokens`, `prune`, `tail_turns`) are not read by v2 and
    // were removed; the v1 `reserved` knob maps to v2 `buffer`.
    "compaction": {
        "auto": true,
        "keep": { "tokens": 12000 },
        "buffer": 16000
    },
    // Bound image token cost for the multimodal flash model. DeepSeek downscales
    // images to ~800x800 internally, so oversized uploads only waste base64
    // bytes. Resize anything above 1600px / 2MB before it reaches the API.
    "media": {
        "image": {
            "auto_resize": true,
            "max_width": 1600,
            "max_height": 1600,
            "max_base64_bytes": 2097152
        }
    },
    "commands": {
        "deep": {
            "description": "Route to deep-worker for heavy implementation",
            "agent": "deep-worker",
            "template": "Handle this task with thoroughness and precision."
        },

        "quick": {
            "description": "Route to light-orchestrator for simple tasks",
            "agent": "light-orchestrator",
            "template": "Handle this task quickly and efficiently."
        },
        "ui": {
            "description": "Route to ui-builder for frontend work",
            "agent": "ui-builder",
            "template": "Build or modify the UI as requested."
        },
        "vision": {
            "description": "Route to vision for multimodal tasks (images, screenshots, diagrams)",
            "agent": "vision",
            "template": "Read the attached image(s) and describe what you see. Report findings with concrete details (text, layout, colors, positions). If the task requires code changes beyond visual interpretation, escalate to deep-worker."
        },
        "review": {
            "description": "Code review — cheap first pass, #high escalation on complex findings",
            "agent": "light-orchestrator",
            "template": "Load the code-review skill and run the tier-1 (thinking off) pass. Scope the change set, compute effective size, and pick the path per the skill. If the path is Abbreviated and no escalation trigger fires, complete the review here and report findings by severity. If any escalation trigger fires (Full path, high-stakes override, trust boundary, or a critical/major finding you cannot confirm from the diff alone), delegate to the `reviewer` subagent (flash#high) and pass your findings as unverified leads. If a PR ref or URL is present in the arguments, also load the gh-cli skill and post findings as a pending GitHub review per its 'Reviewing PRs' section (event=COMMENT, never auto-approve). Do not modify code."
        },
        "deep-review": {
            "description": "Force a deep (deepseek-flash#high) code review, skipping the cheap first pass",
            "agent": "reviewer",
            "template": "Load the code-review skill and run the Full path regardless of size. If a PR ref or URL is present in the arguments, also load the gh-cli skill and post findings as a pending GitHub review per its 'Reviewing PRs' section (event=COMMENT, never auto-approve). Report findings by severity. Do not modify code."
        },
        "plan": {
            "description": "Route to planner for strategic planning",
            "agent": "planner",
            "template": "Create a detailed plan for the following."
        },
        "oracle": {
            "description": "Route to oracle for deep code analysis and root cause debugging",
            "agent": "oracle",
            "template": "Analyze and find the root cause of the following."
        },

        "release": {
            "description": "Prepare a tagged release using the git-release skill",
            "agent": "deep-worker",
            "template": "Load the git-release skill and prepare a tagged release: draft release notes from merged PRs, propose a SemVer bump, and produce the gh release command."
        },
        "reflect": {
            "description": "Review recent work to identify recurring friction and propose minimal config improvements",
            "agent": "oracle",
            "template": "Load the reflect skill. Review recent sessions and work patterns to identify recurring friction points — places where agents repeatedly waste tokens, make the same mistakes, or produce known anti-patterns. Propose minimal, durable improvements to the opencode config (agents, skills, commands, or AGENTS.md rules). Follow the reflect skill's discipline: one friction → one root cause → one minimal fix. Never propose sweeping rewrites or new models."
        },
        "commit": {
            "description": "Stage changes and write a Conventional Commits message",
            "agent": "light-orchestrator",
            "template": "Here is the current state:\n\nStatus:\n!`git status --short`\n\nDiff (staged + unstaged):\n!`git diff HEAD`\n\nStage the relevant changes and write a single commit message following Conventional Commits: type(scope): imperative-mood subject. Types: feat/fix/docs/chore/refactor/test. Use BREAKING CHANGE: footer if applicable. Do not push."
        },
        "handoff": {
            "description": "Compact conversation for next agent session",
            "agent": "light-orchestrator",
            "template": "Load the handoff skill. Compact the current conversation into a handoff document saved to the OS temp directory. Reference existing artifacts (specs, plans, diffs) by path — never copy their content. Include a suggested-skills section for the next session. Redact sensitive information."
        },

        "rmslop": {
            "description": "Remove AI slop and dead code from the current changes",
            "agent": "deep-worker",
            "template": "Load the remove-deadcode skill. Review the current diff and remove AI slop: filler/boilerplate comments that restate the code, commented-out code, needless defensive wrappers, dead code that verification proves is unreferenced. Follow AGENTS.md Comment Discipline. Do not change behavior; verify build/tests still pass and report what you removed."
        },

        "codemap": {
            "description": "Generate a structured hierarchical map of the codebase for quick orientation",
            "agent": "explore",
            "template": "Load the codemap skill and generate an annotated directory tree for this project. Build the raw tree (depth 3, excluding node_modules/.git/dist/build/.next/coverage), annotate key directories with one-line purpose descriptions, and add quick-reference metadata (language, framework, runtime, build/test commands). Keep the whole map under 200 lines. If .opencode/codemap.md exists and appears fresh, update it rather than overwriting."
        },
        "learn": {
            "description": "Extract non-obvious learnings from this session into directory-level AGENTS.md files",
            "agent": "deep-worker",
            "template": "Analyze this session and extract non-obvious learnings to add to AGENTS.md files. AGENTS.md files can exist at any directory level, not just the project root — when an agent reads a file, any AGENTS.md in parent directories are auto-loaded into the tool read. Place learnings as close to the relevant code as possible: project-wide → root AGENTS.md; package/module-specific → packages/foo/AGENTS.md; feature-specific → src/auth/AGENTS.md. Include only non-obvious discoveries: hidden relationships, execution paths that differ from how code appears, non-obvious config/env/flags, debugging breakthroughs, API/tool quirks, build/test commands not in README, architectural decisions, files that must change together. Exclude obvious facts, standard framework behavior, things already in an AGENTS.md, verbose explanations, session-specific details. Keep entries to 1-3 lines per insight. After updating, summarize which AGENTS.md files were created/updated and how many learnings per file."
        },
        "spec-apply": {
            "description": "Implement a spec-driven change task-by-task, verify, then auto-archive on completion",
            "agent": "deep-worker",
            "template": "Load the spec-workflow skill. For the requested change under openspec/changes/: read proposal.md, design.md, delta specs, then work tasks.md one unchecked item at a time, marking each - [x]. If a task is blocked or design proves wrong, update the artifacts. After all tasks complete, run the archive action: fold delta specs into openspec/specs/ and move to openspec/changes/archive/. Run any available verification."
        },
        "spec-propose": {
            "description": "Explore code then draft a spec-driven change proposal (or update an existing one if intent overlaps >50%)",
            "agent": "planner",
            "template": "Load the spec-workflow skill. If there is an existing change under openspec/changes/ with >50% scope overlap to the current intent, run update action on it. Otherwise, scaffold a new openspec/changes/<change-id>/ with proposal.md, tasks.md, delta specs, and design.md only if warranted. Focus on WHY and WHAT, not HOW. Stop after the artifacts are ready for review."
        },
        "simplify": {
            "description": "Simplify code without changing behavior — reduce nesting, remove unnecessary abstraction, cut dead variables",
            "agent": "light-orchestrator",
            "template": "Load the simplify skill. Two-stage flow: (1) spawn the oracle subagent (read-only) to analyze the target file(s) and produce a simplification plan — for each simplification, the exact oldString to replace and newString to use; (2) apply those edits yourself, then verify each change preserves behavior (run tests / re-read). Oracle never edits; you never analyze. If oracle finds no valid simplifications, report that and stop."
        }
    }
}
