{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "orchestrator",
    "model": "deepseek/deepseek-v4-pro",
    "small_model": "deepseek/deepseek-v4-flash",
    "autoupdate": "notify",
    "share": "disabled",
    "lsp": true,
    "formatter": true,
    "subagent_depth": 3,
    "permission": {
        "read": {
            "*": "allow",
            ".env": "deny",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow"
        },
        "bash": {
            "*": "allow",
            "rm -rf*": "ask",
            "rm -fr*": "ask",
            "Remove-Item -Recurse -Force*": "ask",
            "rd /s*": "ask",
            "del /f /s*": "ask",
            "del /f /q*": "ask",
            "format *": "ask",
            "git push --force*": "ask",
            "git push -f *": "ask",
            "git push --force-with-lease*": "ask",
            "git reset --hard*": "ask",
            "git clean -fd*": "ask",
            "git checkout .*": "ask",
            "git checkout --*": "ask",
            "git branch -D*": "ask",
            "git stash clear*": "ask",
            "git stash drop*": "ask",
            "gh repo delete*": "ask",
            "gh pr close*": "ask"
        },
        "skill": {
            "*": "allow"
        },
        "external_directory": "ask"
    },
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0",
        "@tarquinen/opencode-dcp@3.1.15"
    ],
    "instructions": [
        "AGENTS.md"
    ],
    // DeepSeek thinking split (deepseek-harness official): flash disables
    // thinking for cheapest+fastest runs; pro keeps the default (thinking on).
    // The vision-exp model is a flash-tier multimodal variant — same cost
    // profile, so it mirrors flash (thinking off, temperature 0). The
    // modalities block declares image input support; without it OpenCode
    // treats the model as text-only and rejects read_image calls.
    // `options.thinking` is a provider passthrough, not a native schema field:
    // OpenCode forwards it verbatim to the DeepSeek API (OpenAI-format thinking
    // toggle — {"type":"enabled"|"disabled"}).
    // `reasoning_effort` (camelCase `reasoningEffort` in config, lowered to
    // snake_case in the request body) is a REQUEST-LEVEL thinking-strength
    // control (low/high/max), NOT a model id. OpenCode does not auto-generate
    // reasoning-effort variants for DeepSeek, so it must be set manually —
    // per-AGENT via `agent.options` (deep-merged over `model.options`), never
    // at the model level. Keeping it off the model id preserves the 3-model
    // matrix (pro / flash / flash-vision-exp).
    "provider": {
        "deepseek": {
            // `cost` is USD per 1M tokens, off-peak rates effective with the
            // 2026-08-16 peak/off-peak pricing; peak hours charge double these
            // values. DeepSeek publishes no standalone cache-write price —
            // cache writes bill at the cache-miss input rate, so cache_write
            // is mapped from input.
            "models": {
                "deepseek-v4-flash": {
                    "cost": {
                        "input": 0.22,
                        "output": 0.66,
                        "cache_read": 0.007,
                        "cache_write": 0.22
                    },
                    "options": {
                        "temperature": 0,
                        "thinking": { "type": "disabled" }
                    }
                },
                "deepseek-v4-flash-vision-exp": {
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "cost": {
                        "input": 0.22,
                        "output": 0.66,
                        "cache_read": 0.007,
                        "cache_write": 0.22
                    },
                    "options": {
                        "temperature": 0,
                        "thinking": { "type": "disabled" }
                    }
                },
                "deepseek-v4-pro": {
                    "cost": {
                        "input": 0.66,
                        "output": 1.98,
                        "cache_read": 0.022,
                        "cache_write": 0.66
                    }
                }
            }
        }
    },
    "references": {
        "opencode-docs": {
            "repository": "anomalyco/opencode",
            "branch": "dev",
            "description": "Official opencode docs, schema, and configuration examples"
        },
        "deepseek-harness": {
            "repository": "deepseek-ai/deepseek-harness",
            "description": "Official DeepSeek model config guidance: thinking toggle, temperature, prompt-caching, context-window handling, OpenAI-compatible API setup"
        }
    },
    // Built-in utility agents (no .md file). Flash-first policy: build/plan/
    // title/summary/compaction all run on flash. Thinking is controlled at the
    // provider layer (flash = disabled, pro = default), so no per-agent variant
    // or temperature here. Pro stays the global default; heavy work escalates
    // to deep-worker (pro). `fallback` is not a real schema key — omitted;
    // OpenCode falls back small_model -> model internally.
    "agent": {
        "build": { "model": "deepseek/deepseek-v4-flash" },
        "plan": { "model": "deepseek/deepseek-v4-flash" },
        "title": { "model": "deepseek/deepseek-v4-flash" },
        "summary": { "model": "deepseek/deepseek-v4-flash" },
        "compaction": { "model": "deepseek/deepseek-v4-flash" }
    },
    // Trim only oversized tool outputs (full text still saved to disk, preview
    // returned). 800 lines / 20KB balances token savings against re-reads:
    // 200/8192 is too tight and truncates normal file reads, forcing agents to
    // re-read and cost more tokens; 1500 is too loose.
    "tool_output": {
        "max_lines": 800,
        "max_bytes": 20480
    },
    // DCP compresses proactively at its absolute 77K/38K thresholds (see
    // dcp.jsonc); native auto compaction is the near-overflow fallback.
    // prune:true drops stale tool outputs, so the two layers complement rather
    // than overlap.
    "compaction": {
        "auto": true,
        "prune": true,
        "tail_turns": 8,
        "preserve_recent_tokens": 12000,
        "reserved": 10240
    },
    // Bound image token cost for the vision-exp model. DeepSeek downscales
    // images to ~800x800 internally, so oversized uploads only waste base64
    // bytes. Resize anything above 1600px / 2MB before it reaches the API.
    // Key is singular `attachment` (schema-valid); the plural form is ignored.
    "attachment": {
        "image": {
            "auto_resize": true,
            "max_width": 1600,
            "max_height": 1600,
            "max_base64_bytes": 2097152
        }
    },
    "command": {
        "deep": {
            "description": "Route to deep-worker for heavy implementation",
            "agent": "deep-worker",
            "template": "Handle this task with thoroughness and precision."
        },

        "quick": {
            "description": "Route to light-orchestrator for simple tasks",
            "agent": "light-orchestrator",
            "template": "Handle this task quickly and efficiently."
        },
        "ui": {
            "description": "Route to ui-builder for frontend work",
            "agent": "ui-builder",
            "template": "Build or modify the UI as requested."
        },
        "vision": {
            "description": "Route to vision for multimodal tasks (images, screenshots, diagrams)",
            "agent": "vision",
            "template": "Read the attached image(s) and describe what you see. Report findings with concrete details (text, layout, colors, positions). If the task requires code changes beyond visual interpretation, escalate to deep-worker."
        },
        "review": {
            "description": "Route to reviewer for code review (local diff or PR)",
            "agent": "reviewer",
            "template": "Load the code-review skill. If a PR ref or URL is present in the arguments, also load the gh-cli skill and post findings as a pending GitHub review per its 'Reviewing PRs' section (event=COMMENT, never auto-approve). Otherwise scope the local diff and scale depth to its effective size, then review and report findings by severity. Scope-first gate: if the diff is large (>500 effective lines) or trivial, report a scoped plan and stop rather than deep-reviewing. Do not modify code."
        },
        "plan": {
            "description": "Route to planner for strategic planning",
            "agent": "planner",
            "template": "Create a detailed plan for the following."
        },
        "oracle": {
            "description": "Route to oracle for deep code analysis and root cause debugging",
            "agent": "oracle",
            "template": "Analyze and find the root cause of the following."
        },

        "release": {
            "description": "Prepare a tagged release using the git-release skill",
            "agent": "deep-worker",
            "template": "Load the git-release skill and prepare a tagged release: draft release notes from merged PRs, propose a SemVer bump, and produce the gh release command."
        },
        "reflect": {
            "description": "Review recent work to identify recurring friction and propose minimal config improvements",
            "agent": "oracle",
            "template": "Load the reflect skill. Review recent sessions and work patterns to identify recurring friction points — places where agents repeatedly waste tokens, make the same mistakes, or produce known anti-patterns. Propose minimal, durable improvements to the opencode config (agents, skills, commands, or AGENTS.md rules). Follow the reflect skill's discipline: one friction → one root cause → one minimal fix. Never propose sweeping rewrites or new models."
        },
        "commit": {
            "description": "Stage changes and write a Conventional Commits message",
            "agent": "light-orchestrator",
            "template": "Here is the current state:\n\nStatus:\n!`git status --short`\n\nDiff (staged + unstaged):\n!`git diff HEAD`\n\nStage the relevant changes and write a single commit message following Conventional Commits: type(scope): imperative-mood subject. Types: feat/fix/docs/chore/refactor/test. Use BREAKING CHANGE: footer if applicable. Do not push."
        },
        "handoff": {
            "description": "Compact conversation for next agent session",
            "agent": "light-orchestrator",
            "template": "Load the handoff skill. Compact the current conversation into a handoff document saved to the OS temp directory. Reference existing artifacts (specs, plans, diffs) by path — never copy their content. Include a suggested-skills section for the next session. Redact sensitive information."
        },

        "rmslop": {
            "description": "Remove AI slop and dead code from the current changes",
            "agent": "deep-worker",
            "template": "Load the remove-deadcode skill. Review the current diff and remove AI slop: filler/boilerplate comments that restate the code, commented-out code, needless defensive wrappers, dead code that verification proves is unreferenced. Follow AGENTS.md Comment Discipline. Do not change behavior; verify build/tests still pass and report what you removed."
        },

        "codemap": {
            "description": "Generate a structured hierarchical map of the codebase for quick orientation",
            "agent": "explore",
            "template": "Load the codemap skill and generate an annotated directory tree for this project. Build the raw tree (depth 3, excluding node_modules/.git/dist/build/.next/coverage), annotate key directories with one-line purpose descriptions, and add quick-reference metadata (language, framework, runtime, build/test commands). Keep the whole map under 200 lines. If .opencode/codemap.md exists and appears fresh, update it rather than overwriting."
        },
        "learn": {
            "description": "Extract non-obvious learnings from this session into directory-level AGENTS.md files",
            "agent": "deep-worker",
            "template": "Analyze this session and extract non-obvious learnings to add to AGENTS.md files. AGENTS.md files can exist at any directory level, not just the project root — when an agent reads a file, any AGENTS.md in parent directories are auto-loaded into the tool read. Place learnings as close to the relevant code as possible: project-wide → root AGENTS.md; package/module-specific → packages/foo/AGENTS.md; feature-specific → src/auth/AGENTS.md. Include only non-obvious discoveries: hidden relationships, execution paths that differ from how code appears, non-obvious config/env/flags, debugging breakthroughs, API/tool quirks, build/test commands not in README, architectural decisions, files that must change together. Exclude obvious facts, standard framework behavior, things already in an AGENTS.md, verbose explanations, session-specific details. Keep entries to 1-3 lines per insight. After updating, summarize which AGENTS.md files were created/updated and how many learnings per file."
        },
        "spec-apply": {
            "description": "Implement a spec-driven change task-by-task, verify, then auto-archive on completion",
            "agent": "deep-worker",
            "template": "Load the spec-workflow skill. For the requested change under openspec/changes/: read proposal.md, design.md, delta specs, then work tasks.md one unchecked item at a time, marking each - [x]. If a task is blocked or design proves wrong, update the artifacts. After all tasks complete, run the archive action: fold delta specs into openspec/specs/ and move to openspec/changes/archive/. Run any available verification."
        },
        "spec-propose": {
            "description": "Explore code then draft a spec-driven change proposal (or update an existing one if intent overlaps >50%)",
            "agent": "planner",
            "template": "Load the spec-workflow skill. If there is an existing change under openspec/changes/ with >50% scope overlap to the current intent, run update action on it. Otherwise, scaffold a new openspec/changes/<change-id>/ with proposal.md, tasks.md, delta specs, and design.md only if warranted. Focus on WHY and WHAT, not HOW. Stop after the artifacts are ready for review."
        },
        "simplify": {
            "description": "Simplify code without changing behavior — reduce nesting, remove unnecessary abstraction, cut dead variables",
            "agent": "light-orchestrator",
            "template": "Load the simplify skill. Two-stage flow: (1) spawn the oracle subagent (read-only) to analyze the target file(s) and produce a simplification plan — for each simplification, the exact oldString to replace and newString to use; (2) apply those edits yourself, then verify each change preserves behavior (run tests / re-read). Oracle never edits; you never analyze. If oracle finds no valid simplifications, report that and stop."
        }
    }
}
