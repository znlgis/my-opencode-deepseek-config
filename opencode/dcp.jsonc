{
  // No stable tag schema exists for DCP 3.1.15 (plugin ships no schema file;
  // its README points at the unpinned master URL). Removed to avoid a
  // non-reproducible $schema. Keys verified against PluginConfig in
  // dist/lib/config.d.ts of @tarquinen/opencode-dcp@3.1.15.
  "enabled": true,
  "autoUpdate": false,
  "debug": false,

  // Reduce notification noise: show compression summary only, no inline expansion
  "pruneNotification": "minimal",
  "pruneNotificationType": "toast",

  // Manual mode off: allow the model to decide when to compress (vs. waiting for /dcp command)
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },

  // Turn protection: on (preserve N most recent turns from pruning)
  "turnProtection": {
    "enabled": true,
    "turns": 4
  },

  "commands": {
    "enabled": true
  },

  "experimental": {
    // Disable DCP for subagent sessions (short-lived; orchestrator manages upper-level context)
    "allowSubAgents": false,
    "customPrompts": false
  },

  // Protected file patterns: never prune operations on these files
  "protectedFilePatterns": [
    "**/opencode.jsonc",
    "**/AGENTS.md",
    "**/*.env*",
    "**/.opencode/**"
  ],

  // ══════════════════════════════════════════════════════════════
  // Compression strategy — tuned for DeepSeek V4 (1M context window)
  // Proactive compression beats passive overflow: DCP compresses at the
  // thresholds below; native auto compaction (opencode.jsonc) is the
  // near-overflow fallback. The two complement each other.
  // Per-model overrides let pro compress earlier than flash — pro input
  // costs 3x flash, so the expensive window is cut first. Both models are
  // listed explicitly below rather than relying on inheritance.
  // ══════════════════════════════════════════════════════════════
  "compress": {
    // range mode: compress a contiguous conversation range into a high-fidelity summary
    "mode": "range",
    "permission": "allow",
    "showCompression": false,
    // Summary buffer: compressed-summary tokens don't count toward maxContextLimit, fully using the window
    "summaryBuffer": true,

    // Context thresholds are ABSOLUTE token values, not percentages: DeepSeek V4
    // has a 1M window, so 60%/30% would mean 600K/300K — normal sessions
    // (20K-200K) never reach that and DCP would never trigger. Both values sit
    // below DCP's own defaults (100K/50K): compressing earlier re-pays less
    // cached prefix on every later request.
    "maxContextLimit": 77000,
    "minContextLimit": 38000,

    // Per-model overrides — the only model-mapping DCP exposes (keys are matched
    // as exact 'providerID/modelID', verified in dist/index.js). Listed for BOTH
    // models so the routing is explicit rather than inherited:
    //   pro   55K/26K — input costs 3x flash (0.66 vs 0.22 per 1M), so the
    //                   expensive window is cut earliest.
    //   flash 77K/38K — mirrors the global default above.
    "modelMaxLimits": {
      "deepseek/deepseek-v4-pro": 55000,
      "deepseek/deepseek-flash": 77000
    },
    "modelMinLimits": {
      "deepseek/deepseek-v4-pro": 26000,
      "deepseek/deepseek-flash": 38000
    },

    // Nudge every 3 LLM requests (default 5) and from the 12th message after a
    // user message (default 15), in "strong" form (injected as a user-role
    // message). Nudges cost a few hundred tokens; acting on them shrinks the
    // window by tens of thousands, so early-ish nudging is cost-positive.
    "nudgeFrequency": 3,
    "iterationNudgeThreshold": 12,
    "nudgeForce": "strong",

    // Preserve the output of the following tools during compression (avoid losing critical info)
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread"
    ],

    // <protect> tags (off — we have no such usage pattern yet)
    "protectTags": false,
    // Allow DCP to compress user messages (e.g. large log pastes). Setting this
    // true would keep every user message permanently, making 20K+ log pastes
    // incompressible.
    "protectUserMessages": false
  },

  // Auto-pruning strategy
  "strategies": {
    // Duplicate tool-call dedup: same tool+args keeps only the latest output
    "deduplication": {
      "enabled": true,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    },
    // Error tool-input pruning: after 3 turns, remove the input body of erroneous tool calls (keep the error message)
    "purgeErrors": {
      "enabled": true,
      "turns": 3,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    }
  }
}
