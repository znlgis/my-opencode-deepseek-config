{
  // No stable tag schema exists for DCP 3.1.15 (plugin ships no schema file;
  // its README points at the unpinned master URL). Removed to avoid a
  // non-reproducible $schema. Keys verified against PluginConfig in
  // dist/lib/config.d.ts of @tarquinen/opencode-dcp@3.1.15.
  "enabled": true,
  "autoUpdate": false,
  "debug": false,

  // Reduce notification noise: show compression summary only, no inline expansion
  "pruneNotification": "minimal",
  "pruneNotificationType": "toast",

  // Manual mode off: allow the model to decide when to compress (vs. waiting for /dcp command)
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },

  // Turn protection: on (preserve N most recent turns from pruning)
  "turnProtection": {
    "enabled": true,
    "turns": 4
  },

  "commands": {
    "enabled": true
  },

  "experimental": {
    // Disable DCP for subagent sessions (short-lived; orchestrator manages upper-level context)
    "allowSubAgents": false,
    "customPrompts": false
  },

  // Protected file patterns: never prune operations on these files
  "protectedFilePatterns": [
    "**/opencode.jsonc",
    "**/AGENTS.md",
    "**/*.env*",
    "**/.opencode/**"
  ],

  // ══════════════════════════════════════════════════════════════
  // Compression strategy — tuned for DeepSeek V4 (1M context window)
  // Core principle: proactive compression > passive overflow; DCP compresses proactively at the 77K threshold, native auto compaction is the near-overflow fallback — the two complement each other
  // Division of labor: built-in compaction handles auto-trigger + prune (opencode.jsonc); DCP handles proactive dedup + compression thresholds. The two complement each other.
  // Per-model overrides (modelMaxLimits/modelMinLimits) let pro compress earlier than flash — pro input costs 3x flash.
  // ══════════════════════════════════════════════════════════════
  "compress": {
    // range mode: compress a contiguous conversation range into a high-fidelity summary
    "mode": "range",
    "permission": "allow",
    "showCompression": false,
    // Summary buffer: compressed-summary tokens don't count toward maxContextLimit, fully using the window
    "summaryBuffer": true,

    // Context thresholds (absolute token values, not percentages):
    // DeepSeek V4 actually has a 1M context window (not 128K); with percentages, 60%≈600K and
    // 30%≈300K, which normal sessions (20K-200K) never reach, so DCP would never trigger compression.
    // Use absolute token values instead to restore the intended ~77K/38K proactive compression, decoupled from the model window.
    "maxContextLimit": 77000,
    "minContextLimit": 38000,

    // Per-model overrides (keyed by exact 'providerID/modelID'). Pro input costs
    // 3x flash (0.66 vs 0.22 per 1M), so compress pro sessions EARLIER to cut the
    // expensive window; flash keeps the global 77K/38K baseline.
    "modelMaxLimits": {
      "deepseek/deepseek-v4-pro": 55000
    },
    "modelMinLimits": {
      "deepseek/deepseek-v4-pro": 26000
    },

    // Remind compression every 3 LLM requests (more frequent than default 5, tuned for token efficiency)
    "nudgeFrequency": 3,
    // Inject compression reminders starting from the 12th message after a user message (earlier than default 15)
    "iterationNudgeThreshold": 12,
    // Strong nudge: the model is explicitly asked to prioritize compression
    "nudgeForce": "strong",

    // Preserve the output of the following tools during compression (avoid losing critical info)
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread"
    ],

    // <protect> tags (off — we have no such usage pattern yet)
    "protectTags": false,
    // Allow DCP to compress user messages (e.g. large log pastes), key for DeepSeek V4 1M window efficiency.
    // When set to true, all user messages are kept permanently — 20K+ log pastes become incompressible.
    "protectUserMessages": false
  },

  // Auto-pruning strategy
  "strategies": {
    // Duplicate tool-call dedup: same tool+args keeps only the latest output
    "deduplication": {
      "enabled": true,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    },
    // Error tool-input pruning: after 3 turns, remove the input body of erroneous tool calls (keep the error message)
    "purgeErrors": {
      "enabled": true,
      "turns": 3,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    }
  }
}
