{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/znlgis/dsh-video-studio-skill/schemas/design.schema.json",
 "title": "video-studio design（v1.0 设计 DSL）",
 "description": "一份 design.json 描述'这一版长什么样'：结构、视觉、声音、节奏。由 propose.py --confirm 冻结，render 阶段作为唯一画面/声音依据。",
 "type": "object",
 "required": [
  "schema",
  "id",
  "label",
  "pitch",
  "structure",
  "visual",
  "audio",
  "pacing"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "type": "integer",
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
  },
  "label": {
   "type": "string",
   "maxLength": 40
  },
  "pitch": {
   "type": "string",
   "maxLength": 120,
   "description": "一句话立意（给用户看）"
  },
  "_unmatched_constraints": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "采样期附加信息：brief 里没能识别的约束（例如用户写了「要有科幻感」）。不参与指纹、不影响渲染，但它必须被契约接纳，否则采样器吐出的设计自己就过不了校验。"
  },
  "structure": {
   "type": "object",
   "required": [
    "segments"
   ],
   "additionalProperties": false,
   "properties": {
    "segments": {
     "type": "integer",
     "minimum": 1,
     "maximum": 40,
     "description": "段落数（设计期叙事结构）。**保留字段**：design_to_plan 不转 segments，渲染不按它分段；成片段落由 film.json 的 lines 与 grammar 推导。"
    },
    "beats": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "每段叙事用途，如 hook/stat/compare/outro。**保留字段**：designkit 采样会按它记录，但 design_to_plan 只转 target_sec / target_mode，渲染不读 beats。"
    },
    "hold_policy": {
     "type": "string",
     "enum": [
      "none",
      "readable",
      "long"
     ],
     "description": "停留策略。**保留字段，不进渲染计划**：designkit 采样会随机写它、它也进设计指纹的 tempo 维度；design_to_plan 不转这个键，渲染不读它。成片节奏以 pacing.lead/tail/min_dur/hold 为准（枚举仍由 designkit 校验，乱写会被拒）。"
    },
    "target_sec": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 3,
     "maximum": 1800,
     "description": "目标/下限时长的秒数。配合 target_mode 解释：exact=精确目标，at_least=下限。"
    },
    "target_mode": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "exact",
      "at_least",
      null
     ],
     "description": "时长语义：exact=精确目标（双向对账）；at_least=下限（只有不足才告警）。null/缺省按 exact。"
    }
   }
  },
  "visual": {
   "type": "object",
   "required": [
    "palette",
    "family",
    "typography",
    "motif",
    "transition",
    "motion",
    "bias",
    "layout",
    "hud"
   ],
   "additionalProperties": false,
   "properties": {
    "palette": {
     "type": "object",
     "description": "11 个颜色角色。两种写法都认：[r,g,b]（0–255 整数三元素）或 \"#rrggbb\"/\"#rgb\"（与 visual.subtitle.color 同口径；designkit.validate_design 走 stylekit._color_of 现场解析，所以 hex 不会在渲染期崩）。",
     "required": [
      "bg",
      "bg2",
      "surface",
      "ink",
      "muted",
      "dim",
      "accent",
      "accent2",
      "good",
      "bad",
      "rule"
     ],
     "additionalProperties": false,
     "properties": {
      "bg": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "bg2": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "surface": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "ink": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "muted": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "dim": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "accent": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "accent2": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "good": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "bad": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      },
      "rule": {
       "type": [
        "array",
        "string"
       ],
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3,
       "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
      }
     }
    },
    "family": {
     "type": "string",
     "enum": [
      "sans",
      "serif",
      "kai",
      "round"
     ]
    },
    "typography": {
     "type": "object",
     "required": [
      "tracking",
      "line_gap",
      "number",
      "ratio",
      "align"
     ],
     "additionalProperties": false,
     "properties": {
      "tracking": {
       "type": "number",
       "minimum": 0,
       "maximum": 8
      },
      "line_gap": {
       "type": "number",
       "minimum": 1.15,
       "maximum": 1.55
      },
      "number": {
       "type": "string",
       "enum": [
        "dim",
        "serif",
        "cn",
        "block",
        "roman",
        "timecode",
        "dot",
        "gilt"
       ]
      },
      "ratio": {
       "type": "number",
       "minimum": 1,
       "maximum": 3.6
      },
      "align": {
       "type": "string",
       "enum": [
        "left",
        "center",
        "right"
       ]
      }
     }
    },
    "motif": {
     "type": "object",
     "required": [
      "kind",
      "density",
      "detail"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string",
       "enum": [
        "plain",
        "brackets",
        "hairlines",
        "handdrawn",
        "slabs",
        "minimal",
        "letterbox",
        "signal",
        "rays"
       ]
      },
      "density": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "detail": {
       "type": "object"
      }
     }
    },
    "transition": {
     "type": "object",
     "required": [
      "kind",
      "dur"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string",
       "enum": [
        "dip",
        "wash",
        "paper",
        "wipe",
        "cut",
        "iris"
       ]
      },
      "dur": {
       "type": "number",
       "minimum": 0,
       "maximum": 0.6
      }
     }
    },
    "motion": {
     "type": "object",
     "required": [
      "ease",
      "enter",
      "push",
      "breathe_hz"
     ],
     "additionalProperties": false,
     "properties": {
      "ease": {
       "type": "string",
       "enum": [
        "out3",
        "out5",
        "inOut3",
        "outBack"
       ]
      },
      "push": {
       "type": "number",
       "minimum": 0,
       "maximum": 0.16
      },
      "breathe_hz": {
       "type": "number",
       "minimum": 0.2,
       "maximum": 1.2
      },
      "enter": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      }
     }
    },
    "bias": {
     "type": "object",
     "required": [
      "x",
      "y",
      "inset"
     ],
     "additionalProperties": false,
     "properties": {
      "x": {
       "type": "integer",
       "minimum": -240,
       "maximum": 240
      },
      "y": {
       "type": "integer",
       "minimum": -240,
       "maximum": 240
      },
      "inset": {
       "type": "integer",
       "minimum": 0,
       "maximum": 120
      }
     }
    },
    "layout": {
     "type": "string",
     "enum": [
      "left-stack",
      "center-stack",
      "split-right"
     ]
    },
    "hud": {
     "type": "string",
     "enum": [
      "chip-left",
      "corner-line",
      "none"
     ]
    },
    "layout_cycle": {
     "type": "array",
     "minItems": 2,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "enum": [
       "left-stack",
       "center-stack",
       "split-right"
      ]
     },
     "description": "片内版式轮换顺序（可选）。grammar.plan_scenes 在 plan 没有显式 chapter_layout 时，按「章节首次出现的顺序」依次取 cycle[0]、cycle[1]… 循环；同一章内版式固定（观众视角一章是一段整体），换章才换版式——这正是「同一视频内部不要大面积重复」的实现。至少 2 种不同版式（只写一种等于不轮换，designkit.validate_design 报错）。**手写 design 不写这个键时 design_to_plan 不会自动派生**（plan 里就是空列表，grammar 走 layout_default，全片一张版式）；自动派生那段只在 designkit.sample_designs 采样时发生（采样器会写 2–3 种）。"
    },
    "subtitle": {
     "type": "object",
     "additionalProperties": false,
     "description": "字幕样式（可选）。字号 / 位置 / 背板透明度 / 圆角 / 字族 / 颜色 / 折行数全部可写：不写就是 filmkit.py 的默认值（不写时任何两条片子确实会得到同样的字幕带，所以要不同就该改这里）。默认值：size=46、y=null、align=center、plate_alpha=170、radius=10、family=null、color=null、max_lines=2。",
     "properties": {
      "size": {
       "type": "integer",
       "minimum": 20,
       "maximum": 96,
       "default": 46,
       "description": "字幕字号（像素，默认 46）。范围 20–96 与 designkit.validate_design 同源；采样器只在 40–56 之间取「好看」的值，手写可越过但别越界。"
      },
      "y": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 1030,
       "default": null,
       "description": "字幕基线 y（像素；默认 null = 底部安全区，由 filmkit 按画布高度算）。范围 0–1030 与 designkit.validate_design 同源。"
      },
      "align": {
       "type": "string",
       "enum": [
        "center",
        "left"
       ],
       "default": "center",
       "description": "字幕对齐方式（默认 center；left = 左对齐，适合左侧长文版式）。"
      },
      "plate_alpha": {
       "type": "integer",
       "minimum": 0,
       "maximum": 255,
       "default": 170,
       "description": "字幕背板不透明度 0–255（默认 170；0 = 完全透明 = 不画背板）。"
      },
      "radius": {
       "type": "integer",
       "minimum": 0,
       "maximum": 48,
       "default": 10,
       "description": "背板圆角半径（像素，默认 10；0 = 直角）。范围 0–48 与 designkit.validate_design 同源。"
      },
      "family": {
       "type": [
        "string",
        "null"
       ],
       "enum": [
        "sans",
        "serif",
        "kai",
        "round",
        null
       ],
       "default": null,
       "description": "字幕字体族（默认 null = 随主题字体族；sans 可读性最好）。取值同 visual.family 的四族。"
      },
      "color": {
       "type": [
        "array",
        "string",
        "null"
       ],
       "default": null,
       "description": "字幕颜色（默认 null = 随主题墨色低一档）。两种写法都认：[r,g,b] 整数三元素，或 \"#rrggbb\"（与 visual.palette 同口径）。"
      },
      "max_lines": {
       "type": "integer",
       "enum": [
        1,
        2,
        3
       ],
       "default": 2,
       "description": "字幕最多折几行（默认 2；1 = 强单行，超长会被省略/缩字）。范围 1–3 与 designkit.validate_design 同源。"
      }
     }
    },
    "size": {
     "type": "string",
     "enum": [
      "1920x1080",
      "1280x720",
      "960x540",
      "1080x1920",
      "720x1280",
      "540x960"
     ],
     "description": "画幅标注：横屏 16:9（1920x1080 / 1280x720 / 960x540）与竖屏 9:16（1080x1920 / 720x1280 / 540x960）。**保留字段，不进渲染计划**：design_to_plan 不转 size，实际画布由 layoutkit 的 profile 决定（render.py --layout portrait 切到 1080x1920），输出尺寸只允许同比例下采样（filmkit.video_plan 校验，非当前画布比例/上采样一律报错）。本字段只做设计契约校验，与 film.json 的 video 块**不会**互相报错。竖屏是 experimental：版式骨架与 compare/process/chart 已竖屏原生，排版节奏未按竖屏复核。"
    },
    "fps": {
     "type": "integer",
     "enum": [
      24,
      25,
      30,
      50,
      60
     ],
     "description": "帧率标注。**保留字段，不进渲染计划**：design_to_plan 不转 fps，实际帧率取 film.json 的 video.fps（缺省 30），两者不一致也不会报错。"
    }
   }
  },
  "audio": {
   "type": "object",
   "required": [
    "voice",
    "music"
   ],
   "additionalProperties": false,
   "properties": {
    "voice": {
     "description": "两种形态都接受：裸 edge voice id 字符串（如 zh-CN-YunxiNeural），或对象 {mode,id,map,jitter,max_distinct}",
     "type": [
      "object",
      "string"
     ],
     "required": [
      "mode",
      "id"
     ],
     "pattern": "^zh-(?:CN|TW|HK)-[A-Z][A-Za-z]*Neural$",
     "allOf": [
      {
       "if": {
        "properties": {
         "mode": {
          "const": "edge_id"
         }
        },
        "required": [
         "mode"
        ]
       },
       "then": {
        "required": [
         "map",
         "jitter",
         "max_distinct"
        ]
       }
      }
     ],
     "additionalProperties": false,
     "properties": {
      "mode": {
       "type": "string",
       "enum": [
        "edge_id",
        "wav"
       ],
       "description": "edge_id = 从命名音色池取；wav = 用现成录音。**mode=edge_id 时还必须给 map / jitter / max_distinct，id 两种模式都必填**（designkit 按缺字段 fail-closed，不猜默认值）。"
      },
      "id": {
       "type": "string",
       "description": "edge voice id，如 zh-CN-YunxiNeural"
      },
      "rate": {
       "type": "string",
       "default": "+0%",
       "description": "保留字段：designkit 只校验是字符串；design_to_plan 不把逐声线 rate/pitch 带进计划（渲染走 voicekit 的 rate_range / pitch_range 策略），写了不生效。"
      },
      "pitch": {
       "type": "string",
       "default": "+0Hz",
       "description": "保留字段：同 rate，不进入渲染计划（voicekit 的 pitch_range 策略才是真源）。"
      },
      "map": {
       "type": "object",
       "description": "kind -> voice id 或 {mode,id}"
      },
      "jitter": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "max_distinct": {
       "type": "integer",
       "minimum": 1,
       "maximum": 5
      }
     }
    },
    "music": {
     "type": "object",
     "required": [
      "mode",
      "scale",
      "bpm",
      "key",
      "mood",
      "seed"
     ],
     "additionalProperties": false,
     "properties": {
      "mode": {
       "type": "string",
       "enum": [
        "params",
        "file",
        "off"
       ]
      },
      "arranger": {
       "type": "string",
       "description": "保留字段（P2 预留）：design_to_plan 不转 arranger，musicgen.render 也没有编排器注册表；写了不生效。"
      },
      "style": {
       "type": "string",
       "description": "已废弃：配乐没有风格表，这个键不决定任何东西（保留只为老 design.json / 既有 fixture 能继续通过契约校验；designkit.validate_design 也接受它）"
      },
      "bpm": {
       "type": "number",
       "minimum": 40,
       "maximum": 220,
       "description": "BPM（designkit 按 40–220 校验）。**只接受数字**：design 是确定性参数，字符串 \"auto\" 只属于 film.json 的 legacy 兼容链。"
      },
      "key": {
       "type": "string",
       "description": "调性名，必须落在与 scale 对应的调池：minor = Dm/Am/Em/Cm；major = C/G/D/F/A/Bb（stylekit.MINOR_KEYS / MAJOR_KEYS；designkit 报不匹配）。"
      },
      "scale": {
       "type": "string",
       "enum": [
        "minor",
        "major"
       ],
       "description": "调式（designkit 会校验；audio.music.scale 决定大调/小调）"
      },
      "mood": {
       "type": "string",
       "enum": [
        "calm",
        "reflective",
        "hopeful",
        "steady",
        "driving",
        "tense",
        "uplifting"
       ],
       "description": "情绪（designkit.MOODS 7 档）：只决定 musicgen 的 BPM 与织体门限，不指向任何现成曲风。"
      },
      "seed": {
       "type": "integer"
      },
      "gain_db": {
       "type": "number",
       "minimum": -60,
       "maximum": 12
      },
      "duck_db": {
       "type": "number",
       "minimum": 0,
       "maximum": 24
      },
      "sections": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "保留字段：design_to_plan 只转 bpm/key/scale/mood/seed 与 gain_db/duck_db/mode，sections 不进渲染计划；手工分段请写 film.json 的 music.sections。"
      },
      "file": {
       "type": "string",
       "description": "保留字段：design_to_plan 不转 file 路径。设计侧 mode=file 的语义固定为「用外部 work/music.wav」（filmkit.music_plan 只看文件在不在），写这个路径不生效。"
      }
     }
    },
    "sfx": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "density": {
       "type": "string",
       "enum": [
        "none",
        "sparse",
        "normal",
        "rich"
       ]
      },
      "gain_db": {
       "type": "number",
       "minimum": -40,
       "maximum": 12
      },
      "cues": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "保留字段：design_to_plan 只转 gain_db / enabled / density 到 audio_overrides，cues 不进渲染计划；音效提示点请写 film.json 的 sfx.cues（那里才有 sfxkit 配方与 at 锚点）。"
      }
     }
    }
   }
  },
  "pacing": {
   "type": "object",
   "required": [
    "lead",
    "tail",
    "min_dur",
    "hold",
    "item_stagger"
   ],
   "additionalProperties": false,
   "properties": {
    "lead": {
     "type": "number",
     "minimum": 0,
     "maximum": 3
    },
    "tail": {
     "type": "number",
     "minimum": 0,
     "maximum": 3
    },
    "min_dur": {
     "type": "number",
     "minimum": 1,
     "maximum": 12
    },
    "hold": {
     "type": "number",
     "minimum": 0,
     "maximum": 5
    },
    "item_stagger": {
     "type": "number",
     "minimum": 0.05,
     "maximum": 1.2
    }
   }
  }
 }
}
