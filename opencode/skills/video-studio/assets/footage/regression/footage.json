 "lines": [
  {
   "id": "s01",
   "text": "一九三五年春天，三万多人的中央红军，被四十万大军围在川黔之间的群山深处。",
   "sub": "三万对四十万",
   "shot": {
    "source": "film1983",
    "at": 175,
    "why": "开场河谷空镜"
   }
  },
  {
   "id": "s02",
   "text": "就在几个月前，遵义会议刚刚开完。红军的方向很清楚：北渡长江，去和红四方面军会师。",
   "shot": {
    "source": "film1983",
    "at": 303,
    "why": "会议与地图"
   }
  },
  {
   "id": "s03",
   "text": "第一步，是打下赤水河东岸的土城，从宜宾和泸州之间过江。",
   "shot": {
    "source": "film1983",
    "at": 955,
    "why": "渡河准备"
   }
  },
  {
   "id": "s11",
   "text": "雄关漫道真如铁，而今迈步从头越。",
   "shot": {
    "source": "film1983",
    "at": 4050,
    "why": "娄山关后山景"
   }
  },
  {
   "id": "s18",
   "text": "一个团伪装成主力往西，把追兵越带越远；真正的主力直扑乌江。",
   "shot": {
    "source": "film1983",
    "at": 6248,
    "why": "伪装主力"
   }
  },
  {
   "id": "s24",
   "text": "赤水河还在流。那条路上走过的选择，今天还在被人反复讲起。",
   "shot": {
    "source": "film1983",
    "at": 9002,
    "why": "收尾河谷"
   }
  }
 ]
}